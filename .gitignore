# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ──────────────────────────────────────────────
# Frontend — Node / React
# ──────────────────────────────────────────────
node_modules/
/.pnp
.pnp.js
/build
/coverage
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ──────────────────────────────────────────────
# Backend — Python
# ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.egg-info/
dist/
*.egg
.eggs/

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# ──────────────────────────────────────────────
# Environment & Secrets
# ──────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# ──────────────────────────────────────────────
# Uploads & Temp Files
# ──────────────────────────────────────────────
backend/uploads/
backend/temp/
*.wav
*.mp3
*.ogg
*.webm
*.jpg
*.jpeg
*.png
*.bmp
!public/**/*.png
!public/**/*.jpg
!src/**/*.png
!src/**/*.jpg

# ──────────────────────────────────────────────
# ML Models & Large Files
# ──────────────────────────────────────────────
*.pt
*.pth
*.h5
*.pkl
*.bin
*.safetensors
# Allow the letter classifier model and its class map — needed for Render deployment.
# EfficientNet-B0 ONNX is ~20 MB, well within GitHub's 100 MB limit.
!backend/models/letter_classifier.onnx
!backend/models/class_mapping.json

# Faster-Whisper model cache
~/.cache/huggingface/
~/.cache/whisper/

# ──────────────────────────────────────────────
# Test Artifacts
# ──────────────────────────────────────────────
backend/test.wav
backend/test_upload.wav

# ──────────────────────────────────────────────
# IDE & Editor
# ──────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ──────────────────────────────────────────────
# OS
# ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ──────────────────────────────────────────────
# Logs
# ──────────────────────────────────────────────
*.log
logs/

# ──────────────────────────────────────────────
# Markdown Documentation
# ──────────────────────────────────────────────
# Keep README.md only; exclude internal/dev docs
*.md
!README.md

# ──────────────────────────────────────────────
# Documentation Folders
# ──────────────────────────────────────────────
Project Documentations/
Remaining Work/

# ──────────────────────────────────────────────
# Dataset Archives & Credentials
# ──────────────────────────────────────────────
dyslexia-handwriting-dataset/
dyslexia-handwriting-dataset.zip
*.rar
kaggle.json

# ──────────────────────────────────────────────
# Miscellaneous
# ──────────────────────────────────────────────
*.docx
*.pdf
